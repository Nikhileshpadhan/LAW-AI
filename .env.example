# ==============================================================================
# Supreme Court Precedent Analyzer & Legal Argument Engine Environment Configuration
# ==============================================================================

# Groq API Key (Required for LLM Fact Extraction & Argument Synthesis)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Selection
# Primary target: openai/gpt-oss-120b (fallback: openai/gpt-oss-20b or llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Local Bundle Paths (Default points to DATA/ directory in workspace)
CHROMA_DB_PATH=DATA/chroma_vector_db
CHROMA_COLLECTION_NAME=supreme_court_cases_last_5yrs_legalbert
LEGAL_BERT_PATH=DATA/legal_bert_model

# Retrieval Tuning
TOP_K_PER_QUERY=5
MAX_TOTAL_PRECEDENTS=15
MIN_SIMILARITY_THRESHOLD=0.50

# Server Config
HOST=0.0.0.0
PORT=8000
DEBUG=false
