# ==============================================================================
# LAW-AI Backend Environment Variables (For Render.com Web Service)
# Copy these values into: Render Dashboard -> Web Service -> Environment -> Environment Variables
# ==============================================================================

# Python Runtime
PYTHON_VERSION=3.12.9

# Vector Engine Mode: Set to 'qdrant' for 512MB RAM free-tier cloud deployment
VECTOR_BACKEND=qdrant

# Qdrant Cloud Storage
QDRANT_URL=https://7fb7ceeb-beb4-4160-bdb9-f90702a77695.sa-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
CHROMA_COLLECTION_NAME=supreme_court_cases_last_5yrs_legalbert

# Hugging Face Inference API
HF_API_TOKEN=your_huggingface_read_token_here
HF_EMBEDDING_URL=https://router.huggingface.co/hf-inference/models/nlpaueb/legal-bert-base-uncased/pipeline/feature-extraction

# Neon PostgreSQL Database
DATABASE_URL=postgresql://neondb_owner:password@ep-fragrant-night-ao0ghxxc-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Groq LLM API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Security & Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true

# CORS & Frontend Origins (Add your actual Vercel domain here after frontend deployment)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
FRONTEND_URL=https://your-frontend.vercel.app

# RAG Retrieval Parameters
TOP_K_PER_QUERY=5
MAX_TOTAL_PRECEDENTS=15
MIN_SIMILARITY_THRESHOLD=0.50

# Server Config
HOST=0.0.0.0
PORT=10000
DEBUG=false
