# ==============================================================================
# LAW-AI Frontend Environment Variables (For Vercel / Cloudflare Pages)
# Set in: Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================================

# Replace with your actual Render backend URL once deployed:
# e.g., https://law-ai-backend.onrender.com/api/v1
VITE_API_BASE_URL=https://law-ai-backend.onrender.com/api/v1

# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> APIs & Credentials)
# e.g., 1234567890-abcdefg.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
